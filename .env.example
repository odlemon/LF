# Public (browser) API origin. Visible in the client bundle. No secrets.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-only backend base for Next.js auth BFF routes (/api/auth/*).
BACKEND_API_URL=http://localhost:8080/api

# Dev-only. Never set true in production.
# NEXT_PUBLIC_ALLOW_MOCK_CLIENT_AUTH=true
