# Lysp frontend — production.
#
# Committed deliberately. Nothing here is a secret: every NEXT_PUBLIC_* value is inlined into
# the browser bundle and already readable by anyone who loads the site, and BACKEND_API_URL is
# a loopback address that is meaningless off the host. Keeping it out of the repository meant a
# fresh clone could not produce a correct build — the server built without these and reported
# success, which is a worse failure than any of them being visible.
#
# Anything that IS a secret stays out: it belongs in the pm2 process environment or a file
# outside the checkout.

# Empty on purpose. It makes every API call root-relative, so each surface talks to /api on its
# own domain and the browser never issues a cross-origin request. That is what lets one build
# serve three domains with no CORS policy to get wrong and no third-party-cookie rule to break
# a session.
NEXT_PUBLIC_API_URL=/

# Server-only. The Next auth BFF routes (/api/auth/*) call the backend directly over loopback,
# so that traffic never leaves the machine.
BACKEND_API_URL=http://127.0.0.1:8090/api

# Where each surface lives. The middleware uses these to redirect a request that arrived at the
# wrong surface — it is why the landing page's markup never has to know the app's hostname.
NEXT_PUBLIC_LANDING_URL=https://lysp.ai
NEXT_PUBLIC_APP_URL=https://app.lysp.ai
NEXT_PUBLIC_PORTAL_URL=https://client.lysp.ai
