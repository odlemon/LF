# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local deploy secrets (host/password). Safe script may be committed; secrets stay out.
scripts/deploy.local.env
*.credentials.py

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# context folder
/context

# Dev-server logs. They capture request lines and occasionally headers, so they
# are not just noise — they are the kind of file that leaks a bearer token.
*.log
frontend_dev*.log
